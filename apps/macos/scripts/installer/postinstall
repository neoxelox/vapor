#!/bin/sh
# Runs as root when Installer has put Vapor.app in /Applications. It
# puts the `vapor` CLI of the app on the PATH, as a link, so an update
# of the app is an update of the CLI too.
#
# Installer passes the volume it installs to as the third argument.
#
# The script never fails the install: the app is in place by now, and a
# link that cannot be made is a line in the install log, with the place
# where the CLI is. A non-zero exit would tell the user that the whole
# install failed.
set -u

volume="${3:-/}"
volume="${volume%/}"
app_cli="$volume/Applications/Vapor.app/Contents/Helpers/vapor"
link_dir="$volume/usr/local/bin"
link="$link_dir/vapor"

not_linked() {
  echo "vapor: $1; the Vapor CLI is at $app_cli"
  exit 0
}

# /usr/local/bin is on the default PATH of macOS, and a fresh system
# does not have it.
mkdir -p "$link_dir" 2>/dev/null || not_linked "$link_dir cannot be made"

# A link of an earlier install is replaced, and so is a link that
# leads nowhere. Anything else with this name is another program, and
# it stays.
if [ -L "$link" ]; then
  case "$(readlink "$link")" in
    */Vapor.app/Contents/Helpers/vapor) ;;
    *)
      if [ -e "$link" ]; then
        not_linked "$link belongs to another program"
      fi
      ;;
  esac
elif [ -e "$link" ]; then
  not_linked "$link belongs to another program"
fi

ln -sfn "$app_cli" "$link" 2>/dev/null || not_linked "$link cannot be made"
exit 0
