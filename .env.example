# Vapor environment variables reference
#
# This file documents the supported VAPOR_* environment variables used by the
# app, scripts, CI, and packaging flow. Keep values commented out by default.
# Copy only the variables you need into your shell, direnv setup, or CI
# environment. Do not commit real secrets.
# Product versioning does not use an environment variable; edit VERSION and use
# ./scripts/version.sh to change the shared Vapor app + daemon version.

# App runtime variables

# VAPOR_DIR=~/.vapor
# Root directory for vapor.json, logs, and durable state. Repo scripts default
# this to ./.vapor.

# VAPOR_ENV=dev
# Runtime mode. Common values are dev and prod. Repo scripts default to dev,
# while package flow defaults to prod.

# VAPOR_LOG_LEVEL=debug
# Optional runtime log level override: debug, info, warning, or error.

# VAPOR_USE_GITIGNORE=true
# Enables daemon ingestion of recursive .gitignore rules.

# VAPOR_USE_VAPORIGNORE=true
# Enables daemon ingestion of recursive .vaporignore rules.

# VAPOR_LOCAL_SYNC_DIRECTORY=~/Vapor
# Overrides the local sync root passed to the daemon.

# VAPOR_CLOUD_SYNC_DIRECTORY=/Vapor
# Overrides the cloud sync root passed to the daemon.

# VAPOR_PRE_IGNORE_RULES=.git/
# Multi-line .gitignore-style baseline rules applied before discovered ignore
# files.

# VAPOR_POST_IGNORE_RULES=
# Multi-line .gitignore-style override rules applied after discovered ignore
# files.

# Build and packaging variables

# VAPOR_XCODE_SCHEME=
# Required only when scripts/swift/build.sh builds from an Xcode
# project/workspace instead of SwiftPM.

# VAPOR_SIGN_IDENTITY=Developer ID Application: Example, Inc. (TEAMID)
# Developer ID identity passed to codesign for signed distributions.

# VAPOR_ENTITLEMENTS=apps/macos/Entitlements.plist
# Optional entitlements plist path passed to codesign during packaging.

# VAPOR_NOTARY_PROFILE=vapor-notary
# notarytool keychain profile name used by package.sh after credentials are
# stored on the local machine or CI runner.

# VAPOR_NOTARY_KEYCHAIN=/tmp/vapor-release.keychain-db
# Optional keychain path passed to notarytool when the profile is stored in a
# non-default keychain, such as CI release jobs.

# VAPOR_PERF_SMOKE_RUST_MAX_SECONDS=600
# Rust performance smoke threshold used by scripts/perf.sh and perf CI.

# VAPOR_PERF_SMOKE_SWIFT_MAX_SECONDS=900
# Swift performance smoke threshold used by scripts/perf.sh and perf CI.
