# --- Rust / Cargo ---
debug/
target/
**/*.rs.bk
*.pdb
**/mutants.out*/

# --- Swift / Xcode / SwiftPM ---
.build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.xcodeproj/project.xcworkspace/xcuserdata/

# --- Apple platform artifacts ---
.DS_Store
.AppleDouble
.LSOverride

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs / Temp ---
logs/
dist/
tmp/
temp/
*.log
*.tmp

# --- Environment / Secrets ---
.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.cer

# --- Runtime state (local only) ---
.vapor/
vapor-state/
runtime/
data/runtime/

# --- Generated locale mirror (source-of-truth is assets/locales) ---
apps/macos/Sources/VaporCore/Resources/locales/*.json

# SQLite sidecar files (allow explicit DB files if needed)
*.sqlite-wal
*.sqlite-shm

# AI tooling
# .claude holds machine-local agent state, but .claude/skills is the
# committed Claude Code mirror of .agents/skills (symlinks per skill).
.claude/*
!.claude/skills
.codex
.opencode
.cursor
!.cursor/environment.json

# Agent workspace scratch space (notes handed between agents, never shipped)
.context/
